        }
      ],
      "user_message": "Going back to leave, what about probation?",
      "expected_action": "retrieve",
      "expected_sections": ["annual_leave_probation"],
      "expected_query_terms": ["leave", "probation"]
    },
    {
      "id": "reuse_point_two",
      "behavior": "evidence_reuse",
      "history": [
        {
          "user_query": "What are the VPN reset steps?",
          "resolved_query": "What are the VPN reset steps?",
          "active_topic": "VPN access and account recovery",
          "evidence_section": "vpn_access_recovery",
          "answer": "1. Open the identity portal. [Source 1]\n2. Complete multifactor identity verification. [Source 1]\n3. Use the new device-registration link. [Source 1]"
        }
      ],
      "user_message": "Explain point 2 more simply.",
      "expected_action": "reuse_previous",
      "expected_sections": ["vpn_access_recovery"],
      "expected_query_terms": ["identity", "verification"]
    },
    {
      "id": "reuse_show_source",
      "behavior": "evidence_reuse",
      "history": [
        {
          "user_query": "How many annual-leave days do employees receive?",
          "resolved_query": "How many annual-leave days do full-time employees receive?",
          "active_topic": "annual leave",
          "evidence_section": "annual_leave_probation",
          "answer": "Full-time employees receive 20 days per calendar year. [Source 1]"
