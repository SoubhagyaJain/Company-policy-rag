{
  "schema_version": "1.0",
  "name": "Northstar multi-turn grounding benchmark",
  "description": "A deterministic, fictional employee-policy benchmark covering follow-ups, references, fragments, topic switches, topic returns, evidence reuse, ambiguity, and multi-part requests.",
  "document": "data/demo/sample_employee_handbook.md",
  "license": "CC0-1.0",
  "cases": [
    {
      "id": "maternity_probation_pronoun",
      "behavior": "pronoun_resolution",
      "history": [
        {
          "user_query": "What is maternity leave?",
          "resolved_query": "What is maternity leave?",
          "active_topic": "maternity leave",
          "evidence_section": "parental_maternity_leave",
          "answer": "Employees may take up to 16 weeks of paid leave. [Source 1]"
        }
      ],
      "user_message": "Does it apply during probation?",
      "expected_action": "retrieve",
      "expected_sections": ["parental_maternity_leave"],
      "expected_query_terms": ["maternity", "probation"]
    },
    {
      "id": "travel_international_fragment",
      "behavior": "incomplete_followup",
      "history": [
        {
          "user_query": "What is the travel limit?",
          "resolved_query": "What is the business travel limit?",
          "active_topic": "business travel limit",
          "evidence_section": "business_travel_expenses",
          "answer": "Domestic lodging is limited to USD 180 per night. [Source 1]"
        }
      ],
      "user_message": "International?",
      "expected_action": "retrieve",
      "expected_sections": ["business_travel_expenses"],
      "expected_query_terms": ["international", "travel"]
    },
    {
