      "expected_sections": ["remote_work"],
      "expected_query_terms": ["qualifies", "remote", "work"]
    },
    {
      "id": "remote_contractors_followup",
      "behavior": "nested_followup",
      "history": [
        {
          "user_query": "Explain remote work.",
          "resolved_query": "Explain the remote work policy.",
          "active_topic": "remote work policy",
          "evidence_section": "remote_work",
          "answer": "Employees may request remote work under the policy. [Source 1]"
        },
        {
          "user_query": "Who qualifies?",
          "resolved_query": "Who qualifies for the remote work policy?",
          "active_topic": "remote work policy",
          "evidence_section": "remote_work",
          "answer": "Full-time and part-time employees qualify after 30 days. [Source 1]"
        }
      ],
      "user_message": "And contractors?",
      "expected_action": "retrieve",
      "expected_sections": ["remote_work"],
      "expected_query_terms": ["remote", "contractors"]
    },
    {
      "id": "leave_to_vpn_topic_switch",
      "behavior": "topic_switch",
      "history": [
        {
          "user_query": "Tell me about leave.",
          "resolved_query": "Tell me about annual leave.",
          "active_topic": "annual leave",
          "evidence_section": "annual_leave_probation",
          "answer": "Full-time employees receive 20 annual-leave days. [Source 1]"
        }
      ],
      "user_message": "How do I reset VPN?",
      "expected_action": "retrieve",
      "expected_sections": ["vpn_access_recovery"],
      "expected_query_terms": ["reset", "vpn"]
    },
    {
      "id": "return_to_leave_probation",
      "behavior": "topic_return",
      "history": [
        {
          "user_query": "Tell me about leave.",
          "resolved_query": "Tell me about annual leave.",
          "active_topic": "annual leave",
          "evidence_section": "annual_leave_probation",
          "answer": "Full-time employees receive 20 annual-leave days. [Source 1]"
        },
        {
          "user_query": "How do I reset VPN?",
          "resolved_query": "How do I reset VPN access?",
          "active_topic": "VPN access",
          "evidence_section": "vpn_access_recovery",
